# pcloud-tools environment example
# Copy to the active config dir as `.env` and adjust for the machine.

PCLOUD_TOOLS_CORE_DIR=~/p-core

PCLOUD_TOOLS_REMOTE=pcloud:
PCLOUD_TOOLS_CORE_REMOTE=pcloud:core
PCLOUD_TOOLS_VAULT_REMOTE=pcloud:vault
PCLOUD_TOOLS_CRYPT_REMOTE=pcloud-crypt:

PCLOUD_TOOLS_VAULT_DIR=~/p-vault
PCLOUD_TOOLS_VAULT_MOUNT_DIR=~/.pcloud/vault
PCLOUD_TOOLS_CRYPT_DIR=~/p-crypt
PCLOUD_TOOLS_CRYPT_MOUNT_DIR=~/.pcloud/crypt
PCLOUD_TOOLS_ENABLE_VAULT_LAYER=1
PCLOUD_TOOLS_ENABLE_CRYPT_LAYER=1

PCLOUD_TOOLS_VAULT_ENGINE=webdav
PCLOUD_TOOLS_CRYPT_ENGINE=webdav
PCLOUD_TOOLS_VAULT_PORT=5566
PCLOUD_TOOLS_CRYPT_PORT=5567

PCLOUD_TOOLS_STATE_DIR=~/.pcloud
PCLOUD_TOOLS_LOG_DIR=~/.pcloud/logs

PCLOUD_TOOLS_AUTOSYNC_LABEL=com.example.pcloud-bisync
PCLOUD_TOOLS_AUTOSYNC_PLIST=~/Library/LaunchAgents/com.example.pcloud-bisync.plist
PCLOUD_TOOLS_DEFAULT_EXCLUDES=config/dotfiles/.ssh/agent/**,.DS_Store,**/.DS_Store

PCLOUD_TOOLS_ALLOWLIST_FILE=~/p-core/.pcloud-sync-allowlist
PCLOUD_TOOLS_MANAGER_IGNORE_FILE=~/p-core/.pcloudmanagerignore
PCLOUD_TOOLS_REMOTE_TRASH_ROOT=pcloud:core/.pcloud-manager-trash
PCLOUD_TOOLS_REMOTE_TRASH_INDEX_FILE=~/.pcloud/pushd/trash-index.sqlite
PCLOUD_TOOLS_REMOTE_TRASH_WARN_BYTES=5368709120
PCLOUD_TOOLS_INDEXER_BIN=~/bin/pcloud-indexer
PCLOUD_TOOLS_NOTIFY_BIN=~/bin/notify
PCLOUD_TOOLS_CHAT_NOTIFY_ENABLED=0
PCLOUD_TOOLS_CHAT_NOTIFY_CMD=~/bin/notify send --to target {message}
PCLOUD_TOOLS_RCLONE_BIN=rclone

# Keep execution gates blank for normal inspection and preview workflows.
# Open a gate only as part of a reviewed operation described by command help.
PCLOUD_TOOLS_TRANSFER_EXECUTION_GATE=
PCLOUD_TOOLS_PUSHD_FSWATCH_RESIDENT_GATE=
PCLOUD_TOOLS_DIFFD_API_LONG_POLL_GATE=
PCLOUD_TOOLS_AUTOSYNC_LAUNCHD_GATE=
PCLOUD_TOOLS_SYNC_MIGRATION_GATE=
PCLOUD_TOOLS_TRANSFER_EXEC_TIMEOUT_SECONDS=5
PCLOUD_TOOLS_DOWNLOAD_SUPPRESSION_TTL_SECONDS=86400
PCLOUD_TOOLS_PUSHD_MISSING_LOCAL_PRUNE_TTL_SECONDS=600
PCLOUD_TOOLS_PUSHD_UPLOAD_SETTLE_SECONDS=30

PCLOUD_TOOLS_PUSHD_DEBOUNCE_SECONDS=3
PCLOUD_TOOLS_PUSHD_QUEUE_LIMIT=1000
PCLOUD_TOOLS_DIFFD_POLL_INTERVAL_SECONDS=60
PCLOUD_TOOLS_DIFFD_BATCH_LIMIT=100

PCLOUD_TOOLS_PCLOUD_API_BASE_URL=https://api.pcloud.com
PCLOUD_TOOLS_PCLOUD_API_AUTH_PARAM=auth
PCLOUD_TOOLS_PCLOUD_API_TOKEN=
PCLOUD_TOOLS_PCLOUD_API_TIMEOUT_SECONDS=30
